# Shared visual language. Import with `...@classes` into any diagram beside this file.
classes: {
  svc: {shape: hexagon; style.fill: "#e8f0fe"}
  store: {shape: cylinder; style.fill: "#fff4e5"}
  queue: {shape: queue}
  ext: {shape: cloud; style.stroke-dash: 3}
  person: {shape: person}
  async: {style: {stroke-dash: 4; animated: true}}
  muted: {style.opacity: 0.4}
}
